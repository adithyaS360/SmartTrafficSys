# Smart Traffic Management System - Environment Variables
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env to git (add it to .gitignore)

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=traffic_db
DB_USER=traffic_user
DB_PASSWORD=your_postgres_password_here
DB_POOL_SIZE=10

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=False
SECRET_KEY=your_secret_key_here_generate_with_secrets.token_hex(32)

# YOLO Model Path
MODEL_WEIGHTS_PATH=./models/yolov8n.pt

# Feature Flags
ENABLE_ML_PREDICTIONS=False
ENABLE_EMERGENCY_DETECTION=False

# Logging
LOG_LEVEL=INFO
